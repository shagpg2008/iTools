msgstr "Cílová šířka: %lu číslic; Soubory %lu budou přejmenovány."

msgid "Testing has been stopped."
msgstr "Testování bylo zastaveno."

msgid "Testing is complete."
msgstr "Testování je dokončeno."

msgid "Text"
msgstr "Text"

msgid "Text encoding is detected according to GB18030-2022, UTF-8, and local code page. The maximum single file size is 256 MiB."
msgstr "Kódování textu je detekováno podle GB18030-2022, UTF-8 a místní kódové stránky. Maximální velikost jednoho souboru je 256 MiB."

msgid "Text is hashed using UTF-8 encoding"
msgstr "Text je hašován pomocí kódování UTF-8"

msgid "Text is processed using UTF-8 encoding"
msgstr "Text je zpracován pomocí kódování UTF-8"

msgid "The BIN file cannot be read, or the file exceeds 256 MiB."
msgstr "Soubor BIN nelze přečíst nebo soubor přesahuje 256 MiB."

msgid "The MQTT PUBLISH topic is invalid."
msgstr "Téma MQTT PUBLISH je neplatné."

msgid "The MQTT SUBACK is invalid or the subscription was refused."
msgstr "MQTT SUBACK je neplatný nebo bylo předplatné odmítnuto."

msgid "The MQTT SUBSCRIBE message is invalid."
msgstr "Zpráva MQTT SUBSCRIBE je neplatná."

msgid "The MQTT publish topic is invalid."
msgstr "Téma publikování MQTT je neplatné."

msgid "The MQTT subscription topic is invalid."
msgstr "Téma předplatného MQTT je neplatné."

msgid "The UTC date or time is outside the valid range."
msgstr "Datum nebo čas UTC je mimo platný rozsah."

msgid "The UTC time contains an invalid number."
msgstr "Čas UTC obsahuje neplatné číslo."

msgid "The UTC time format should be YYYY-MM-DD HH:MM:SS[.mmm]."
msgstr "Formát času UTC by měl být RRRR-MM-DD HH:MM:SS[.mmm]."

msgid "The WebSocket peer has closed the connection."
msgstr "Partner WebSocket ukončil připojení."

msgid "The barcode content cannot be empty."
msgstr "Obsah čárového kódu nemůže být prázdný."

msgid "The baud rate must be an integer between 1 and 4000000."
msgstr "Přenosová rychlost musí být celé číslo mezi 1 a 4000000."

msgid "The decoded result is not UTF-8 text. Output to a file to preserve the binary data."
msgstr "Dekódovaný výsledek není text UTF-8. Výstup do souboru pro zachování binárních dat."

msgid "The dropped file or directory is invalid."
msgstr "Zahozený soubor nebo adresář je neplatný."

msgid "The file exceeds 16 MiB. Write to a file to avoid excessive text-box memory use."
msgstr "Soubor přesahuje 16 MiB. Zapisujte do souboru, abyste se vyhnuli nadměrnému využití paměti textového pole."

msgid "The header file directory is invalid."
msgstr "Adresář souboru záhlaví je neplatný."

msgid "The input and output files cannot be the same."
msgstr "Vstupní a výstupní soubory nemohou být stejné."

msgid "The language setting could not be saved."
msgstr "Nastavení jazyka nelze uložit."

msgid "The last member must be an array for a dynamic tail array."
msgstr "Poslední člen musí být pole pro dynamické pole ocasu."

msgid "The match expression cannot be empty."
msgstr "Shodný výraz nemůže být prázdný."

msgid "The parsing results have been cleared."
msgstr "Výsledky analýzy byly vymazány."

msgid "The penultimate member must be an 8-32 bit integer scalar for a dynamic tail array."
msgstr "Předposlední člen musí být 8-32bitový celočíselný skalár pro dynamické pole zakončení."

msgid "The receive cache has exceeded the limit and has been cleared."
msgstr "Mezipaměť příjmu překročila limit a byla vymazána."

msgid "The received data cannot be empty."
msgstr "Přijatá data nemohou být prázdná."

msgid "The received frames cannot be the same or prefix each other, otherwise the TCP/serial port cannot determine the frame boundary."
msgstr "Přijaté rámce nemohou být stejné nebo před sebou, jinak TCP/sériový port nemůže určit hranici rámce."

msgid "The regular expression is invalid."
msgstr "Regulární výraz je neplatný."

msgid "The replacement produced an invalid filename."
msgstr "Nahrazení vytvořilo neplatný název souboru."

msgid "The request received was not a valid MQTT 3.1.1 CONNECT."
msgstr "Přijatý požadavek nebyl platný MQTT 3.1.1 CONNECT."

msgid "The request received was not a valid WebSocket RFC 6455 handshake."
msgstr "Přijatý požadavek nebyl platným navázáním spojení WebSocket RFC 6455."

msgid "The root structure is invalid."
msgstr "Kořenová struktura je neplatná."

msgid "The serial port or host cannot be empty."
msgstr "Sériový port nebo hostitel nesmí být prázdný."

msgid "The server has ended."
msgstr "Server skončil."

msgid "The server has stopped."
msgstr "Server se zastavil."

msgid "The server rejected the WebSocket upgrade or the handshake response was invalid."
msgstr "Server odmítl upgrade WebSocket nebo byla odpověď handshake neplatná."

msgid "The two folders cannot be the same, nor can they be subdirectories of each other."
msgstr "Tyto dvě složky nemohou být stejné, ani nemohou být navzájem podadresáři."

msgid "The value format is invalid or outside the range of a 64-bit unsigned integer."
msgstr "Formát hodnoty je neplatný nebo je mimo rozsah 64bitového celého čísla bez znaménka."

msgid "Timeout (ms):"
msgstr "Časový limit (ms):"

msgid "Timestamp"
msgstr "Časové razítko"

msgid "Timestamp converter"
msgstr "Konvertor časových razítek"

msgid "To be synchronized: %lu files"
msgstr "K synchronizaci: soubory %lu"

msgid "Tools"
msgstr "Nástroje"

msgid "Total lines"
msgstr "Celkem řádků"

msgid "Try again:"
msgstr "Zkuste to znovu:"

msgid "UDP reception failed."
msgstr "Příjem UDP se nezdařil."

msgid "UDP send failed."
msgstr "Odeslání UDP se nezdařilo."

msgid "UTC input may use a space or T separator and an optional trailing Z."
msgstr "Vstup UTC může používat oddělovač mezery nebo T a volitelný koncový Z."

msgid "UTC time (YYYY-MM-DD HH:MM:SS[.mmm])"
msgstr "Čas UTC (RRRR-MM-DD HH:MM:SS[.mmm])"

msgid "UTC time converted to a Unix timestamp."
msgstr "Čas UTC převedený na unixové časové razítko."

msgid "UTF-8 text"
msgstr "Text UTF-8"

msgid "Unable to bind UDP port."
msgstr "Nelze svázat port UDP."

msgid "Unable to calculate relative path:"
msgstr "Nelze vypočítat relativní cestu:"

msgid "Unable to create communication channel."
msgstr "Nelze vytvořit komunikační kanál."

msgid "Unable to create file mapping (error %lu)"
msgstr "Nelze vytvořit mapování souborů (chyba %lu)"

msgid "Unable to get file size (%s)"
msgstr "Nelze získat velikost souboru (%s)"

msgid "Unable to get file size (error %lu)"
msgstr "Nelze získat velikost souboru (chyba %lu)"

msgid "Unable to initialize the network socket subsystem; network tools are unavailable."
msgstr "Nelze inicializovat subsystém síťového soketu; síťové nástroje nejsou k dispozici."

msgid "Unable to listen on MQTT port."
msgstr "Nelze poslouchat na portu MQTT."

msgid "Unable to listen on TCP port."
msgstr "Nelze poslouchat na portu TCP."

msgid "Unable to listen on WebSocket port."
msgstr "Nelze poslouchat na portu WebSocket."

msgid "Unable to open UDP local port (address family or port not available)."
msgstr "Nelze otevřít místní port UDP (rodina adres nebo port není k dispozici)."

msgid "Unable to open file: %s (%s)"
msgstr "Nelze otevřít soubor: %s (%s)"

msgid "Unable to open file: %s (error %lu)"
msgstr "Nelze otevřít soubor: %s (chyba %lu)"

msgid "Unable to open serial port:"
msgstr "Nelze otevřít sériový port:"

msgid "Unable to read directory:"
msgstr "Nelze číst adresář:"

msgid "Unable to read header file, or file exceeds 16 MiB:"
msgstr "Nelze přečíst soubor záhlaví nebo soubor přesahuje 16 MiB:"

msgid "Unable to read serial port configuration."
msgstr "Nelze přečíst konfiguraci sériového portu."

msgid "Unable to reread file during replacement: "
msgstr "Během výměny nelze znovu přečíst soubor:"

msgid "Unable to resolve IPv4/IPv6 address:"
msgstr "Nelze přeložit adresu IPv4/IPv6:"

msgid "Unable to resolve IPv4/IPv6 listening address:"
msgstr "Nelze přeložit IPv4/IPv6 naslouchací adresu:"

msgid "Unable to resolve type:"
msgstr "Nelze vyřešit typ:"

msgid "Unable to set serial port parameters."
msgstr "Nelze nastavit parametry sériového portu."

msgid "Unable to start server thread."
msgstr "Nelze spustit vlákno serveru."

msgid "Unable to start test thread."
msgstr "Testovací vlákno nelze spustit."

msgid "Unix / UTC conversion"
msgstr "Převod Unix / UTC"

msgid "Unix seconds are outside the convertible range."
msgstr "Sekundy Unixu jsou mimo konvertibilní rozsah."

msgid "Unix timestamp"
msgstr "Unixové časové razítko"

msgid "Unix timestamp cannot be empty."
msgstr "Unixové časové razítko nemůže být prázdné."

msgid "Unix timestamp converted to UTC."
msgstr "Unixové časové razítko převedené na UTC."

msgid "Unix timestamp is not a valid 64-bit integer."
msgstr "Unixové časové razítko není platné 64bitové celé číslo."

msgid "Unknown or undefined member type."
msgstr "Neznámý nebo nedefinovaný typ členu."

msgid "Use private key"
msgstr "Použijte soukromý klíč"

msgid "Use public key"
msgstr "Použijte veřejný klíč"

msgid "Use regular expressions to replace filenames and text in batches"
msgstr "Použijte regulární výrazy k nahrazení názvů souborů a textu v dávkách"

msgid "Used to make dictionary order consistent with natural numbering order and to check for conflicts before renaming."
msgstr "Používá se k zajištění souladu pořadí slovníků s přirozeným pořadím číslování a ke kontrole konfliktů před přejmenováním."

msgid "Value copied to the clipboard."
msgstr "Hodnota zkopírována do schránky."

msgid "Value range: 0 to 2^64-1"
msgstr "Rozsah hodnot: 0 až 2^64-1"

msgid "Verify response content (only wait for the configured length when unchecked)"
msgstr "Ověřte obsah odpovědi (není-li zaškrtnuto, počkejte pouze na nakonfigurovanou délku)"

msgid "Version %d; %d × %d modules; image %d × %d."
msgstr "Verze %d; moduly %d × %d; obrázek %d × %d."

msgid "View and edit every bit of a 64-bit unsigned integer"
msgstr "Prohlížejte a upravujte každý bit 64bitového celého čísla bez znaménka"

msgid "Warning: Crypto++ names its XXTEA implementation BTEA and marks it as not thoroughly tested; input must be at least 8 bytes and a multiple of 4."
msgstr "Upozornění: Crypto++ nazývá svou implementaci XXTEA BTEA a označuje ji jako nedůkladně testovanou; vstup musí být alespoň 8 bajtů a násobek 4."

msgid "Warning: ECB exposes data patterns and is not recommended for real data."
msgstr "Upozornění: ECB odhaluje datové vzorce a nedoporučuje se pro skutečná data."

msgid "Warning: Prefer OAEP; PKCS#1 v1.5 is provided only for compatibility."
msgstr "Upozornění: Preferujte OAEP; PKCS#1 v1.5 je poskytován pouze z důvodu kompatibility."

msgid "Warning: This algorithm is insecure and is provided only for legacy compatibility."
msgstr "Upozornění: Tento algoritmus je nezabezpečený a je poskytován pouze z důvodu kompatibility se staršími verzemi."

msgid "Warning: This algorithm is intended for legacy systems or protocols; prefer AES-GCM for new data."
msgstr "Upozornění: Tento algoritmus je určen pro starší systémy nebo protokoly; pro nová data preferujte AES-GCM."

msgid "WebSocket HTTP header is too large or incomplete."
msgstr "HTTP hlavička WebSocket je příliš velká nebo neúplná."

msgid "WebSocket TCP connection failed or timed out."
msgstr "Připojení WebSocket TCP selhalo nebo vypršel časový limit."

msgid "WebSocket client"
msgstr "Klient WebSocket"

msgid "WebSocket connection disconnected."
msgstr "Připojení WebSocket odpojeno."

msgid "WebSocket handshake connection broken."
msgstr "Spojení handshake WebSocket bylo přerušeno."

msgid "WebSocket handshake timed out."
msgstr "Vypršel časový limit pro handshake WebSocket."

msgid "WebSocket message exceeds 16 MiB limit."
msgstr "Zpráva WebSocket překračuje limit 16 MiB."

msgid "WebSocket path mismatch."
msgstr "Neshoda cesty WebSocket."

msgid "WebSocket request path, such as /ws; currently supports ws://, but does not support TLS/wss://"
msgstr "Cesta požadavku WebSocket, například /ws; aktuálně podporuje ws://, ale nepodporuje TLS/wss://"

msgid "WebSocket send failed or the connection was disconnected."
msgstr "Odeslání WebSocket se nezdařilo nebo bylo odpojeno připojení."

msgid "When response validation is enabled, the expected response cannot be empty."
msgstr "Když je povoleno ověřování odpovědi, očekávaná odpověď nemůže být prázdná."

msgid "Width"
msgstr "šířka"

msgid "Width is calculated separately for each folder; %lu files will be renamed."
msgstr "Šířka se počítá zvlášť pro každou složku; bude přejmenováno %lu souborů."

msgid "Windows supports 1/1.5/2 stop bits, all checksums, and flow control combinations; the specific combinations of Linux/macOS are limited by the system driver."
msgstr "Windows podporuje 1/1,5/2 stop bity, všechny kontrolní součty a kombinace řízení toku; konkrétní kombinace Linux/macOS jsou omezeny systémovým ovladačem."

