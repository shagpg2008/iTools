msgstr "완료됨: %lu 파일이 수정되었습니다."

msgid "Completed: %lu files renamed."
msgstr "완료됨: %lu 파일 이름이 변경되었습니다."

msgid "Confirm rename"
msgstr "이름 변경 확인"

msgid "Confirm replacement"
msgstr "교체 확인"

msgid "Confirm synchronization"
msgstr "동기화 확인"

msgid "Content matches"
msgstr "콘텐츠 일치"

msgid "Conversion completed."
msgstr "변환이 완료되었습니다."

msgid "Convert"
msgstr "변환"

msgid "Convert between 64-bit Unix timestamps and UTC date/time"
msgstr "64비트 Unix 타임스탬프와 UTC 날짜/시간 간 변환"

msgid "Convert between hexadecimal strings and ASCII"
msgstr "16진수 문자열과 ASCII 간 변환"

msgid "Convert files or UTF-8 text to and from Base64"
msgstr "파일 또는 UTF-8 텍스트를 Base64로 변환하거나 반대로 변환"

msgid "Convert to Base64"
msgstr "Base64로 변환"

msgid "Convert to UTC ↓"
msgstr "UTC로 변환 ↓"

msgid "Convert to Unix ↑"
msgstr "유닉스로 변환 ↑"

msgid "Converted bytes: %llu"
msgstr "변환된 바이트 수: %llu"

msgid "Copied to the clipboard."
msgstr "클립보드에 복사되었습니다."

msgid "Copy"
msgstr "복사"

msgid "Copy image"
msgstr "이미지 복사"

msgid "Copy result"
msgstr "결과 복사"

msgid "Count a single file or directory, you can choose whether to recurse and customize the extension; count total lines, code, comments and blank lines respectively;"
msgstr "단일 파일이나 디렉터리를 계산하면 확장명을 반복하고 사용자 정의할지 여부를 선택할 수 있습니다. 총 줄, 코드, 주석 및 빈 줄을 각각 계산합니다."

msgid "Count results cleared."
msgstr "집계 결과가 삭제되었습니다."

msgid "Count total, code, comment, and blank lines by file"
msgstr "파일별로 합계, 코드, 주석 및 빈 줄 계산"

msgid "Crypto++ conversion failed: "
msgstr "Crypto++ 변환 실패:"

msgid "Current UTC time loaded."
msgstr "현재 UTC 시간이 로드되었습니다."

msgid "Current time"
msgstr "현재 시간"

msgid "Custom"
msgstr "맞춤"

msgid "Custom Init, Poly, and XorOut must be hexadecimal numbers."
msgstr "사용자 정의 Init, Poly 및 XorOut은 16진수여야 합니다."

msgid "Custom Width supports only 8, 16, 24, 32, or 64."
msgstr "사용자 정의 너비는 8, 16, 24, 32 또는 64만 지원합니다."

msgid "Custom algorithm: Width, Init, Poly, XorOut, RefIn, RefOut can be set, and multiple algorithm calculations can be selected at the same time."
msgstr "사용자 정의 알고리즘: Width, Init, Poly, XorOut, RefIn, RefOut을 설정할 수 있으며 여러 알고리즘 계산을 동시에 선택할 수 있습니다."

msgid "DES (legacy)"
msgstr "DES(레거시)"

msgid "Data bits:"
msgstr "데이터 비트:"

msgid "Decimal"
msgstr "소수"

msgid "Decode from Base64"
msgstr "Base64에서 디코딩"

msgid "Decrypt"
msgstr "암호 해독"

msgid "Decryption"
msgstr "암호 해독"

msgid "Delay before sending (ms):"
msgstr "전송 전 지연 시간(ms):"

