msgid "%lu characters; image %d × %d."
msgstr "%lu 문자; 이미지 %d × %d."

msgid "%lu files completed; failed to rename:\n%s"
msgstr "%lu 파일이 완료되었습니다. 이름을 바꾸지 못했습니다:\n%s"

msgid "%lu files will be copied; newer files of the same name will overwrite older files. Continue?"
msgstr "%lu 파일이 복사됩니다. 같은 이름의 최신 파일은 이전 파일을 덮어씁니다. 계속하다?"

msgid "%lu files: total %lu, code %lu, comments %lu, blank %lu; skipped %lu"
msgstr "%lu 파일: 총 %lu, 코드 %lu, 주석 %lu, 공백 %lu; %lu를 건너뛰었습니다."

msgid "%lu header file entries have been loaded; include will be expanded recursively during parsing."
msgstr "%lu 헤더 파일 항목이 로드되었습니다. include는 구문 분석 중에 재귀적으로 확장됩니다."

msgid "%s completed: %u -> %u bytes"
msgstr "%s 완료: %u -> %u 바이트"

msgid "/ No verification"
msgstr "/ 검증 없음"

msgid "/check"
msgstr "/체크"

msgid "1 byte (compact)"
msgstr "1바이트(컴팩트)"

msgid "1.5 stop bits can only be used in combination with 5 data bits."
msgstr "1.5 정지 비트는 5 데이터 비트와 조합해서만 사용할 수 있습니다."

msgid "2 bytes"
msgstr "2바이트"

msgid "3DES (legacy)"
msgstr "3DES(레거시)"

msgid "4 bytes"
msgstr "4바이트"

msgid "5 data bits cannot be combined with 2 stop bits."
msgstr "5개의 데이터 비트는 2개의 정지 비트와 결합될 수 없습니다."

msgid "64-bit unsigned integer"
msgstr "64비트 부호 없는 정수"

msgid "8 bytes"
msgstr "8바이트"

msgid "A custom parameter exceeds the bit width specified by Width."
msgstr "사용자 정의 매개변수가 너비로 지정된 비트 너비를 초과합니다."

msgid "A duplicate target filename exists; operation stopped."
msgstr "중복된 대상 파일 이름이 존재합니다. 작동이 중지되었습니다."

msgid "A sync preview will be automatically generated after selecting two folders."
msgstr "두 개의 폴더를 선택하면 동기화 미리보기가 자동으로 생성됩니다."

msgid "A zero-length array is only supported as the last structure member."
msgstr "길이가 0인 배열은 마지막 구조체 멤버로만 지원됩니다."

msgid "AAD (UTF-8):"
msgstr "AAD(UTF-8):"

msgid "ASCII converter"
msgstr "ASCII 변환기"

msgid "ASCII string"
msgstr "ASCII 문자열"

msgid "ASCII text can only contain characters from 0x00 to 0x7F."
msgstr "ASCII 텍스트는 0x00부터 0x7F까지의 문자만 포함할 수 있습니다."

msgid "ASCII text cannot be empty."
msgstr "ASCII 텍스트는 비워둘 수 없습니다."

msgid "About (&A)"
msgstr "(&A) 소개"

msgid "About iTool"
msgstr "iTool 소개"

msgid "About to modify %lu files. This cannot be undone automatically. Continue?"
msgstr "%lu 파일을 수정하려고 합니다. 이 작업은 자동으로 취소할 수 없습니다. 계속하다?"

msgid "About to rename %lu files. Continue?"
msgstr "%lu 파일의 이름을 바꾸려고 합니다. 계속하다?"

msgid "Add leading zeros to numbered filenames for natural sorting"
msgstr "자연스러운 정렬을 위해 번호가 매겨진 파일 이름 앞에 0을 추가합니다."

msgid "Add new receive/send pair"
msgstr "새로운 수신/전송 쌍 추가"

msgid "Add new send/receive pair"
msgstr "새로운 보내기/받기 쌍 추가"

msgid "Added receive/send mapping"
msgstr "수신/전송 매핑이 추가되었습니다."

msgid "Adds 80 first, then pads with 00."
msgstr "먼저 80을 더한 다음 00으로 채웁니다."

msgid "Algorithm and parameters"
msgstr "알고리즘 및 매개변수"

msgid "Algorithm:"
msgstr "알고리즘:"

msgid "Algorithms (22 types): MD5; SHA1; SHA2-224/256/384/512; SHA3-224/256/384/512; Keccak-224/256/384/512; RIPEMD-128/160/256/320; BLAKE2s-256; BLAKE2b-256/512; SM3. Multiple algorithms can be calculated at once."
msgstr "알고리즘(22종): MD5; SHA1; SHA2-224/256/384/512; SHA3-224/256/384/512; 케착-224/256/384/512; RIPEMD-128/160/256/320; BLAKE2s-256; BLAKE2b-256/512; SM3. 여러 알고리즘을 한 번에 계산할 수 있습니다."

msgid "Aliases cannot be provided after the closing curly brace of a non-typedef structure."
msgstr "typedef 구조가 아닌 경우 닫는 중괄호 뒤에 별칭을 제공할 수 없습니다."

msgid "Alignment:"
msgstr "정렬:"

msgid "All files (*.*)|*.*"
msgstr "모든 파일(*.*)|*.*"

msgid "Anonymous structures must provide a typedef name."
msgstr "익명 구조는 typedef 이름을 제공해야 합니다."

msgid "Any non-empty"
msgstr "비어 있지 않은 모든 것"

msgid "Array length missing."
msgstr "배열 길이가 누락되었습니다."

msgid "Array length must be a positive integer or a defined numeric macro."
msgstr "배열 길이는 양의 정수이거나 정의된 숫자 매크로여야 합니다."

msgid "Array length must be greater than zero."
msgstr "배열 길이는 0보다 커야 합니다."

msgid "Automatically calculate checksum, adjust zoom and copy image or save as PNG."
msgstr "체크섬을 자동으로 계산하고 확대/축소를 조정하고 이미지를 복사하거나 PNG로 저장합니다."

msgid "BIN file"
msgstr "BIN 파일"

msgid "Barcode encoder"
msgstr "바코드 인코더"

msgid "Barcode encoding"
msgstr "바코드 인코딩"

msgid "Barcode height:"
msgstr "바코드 높이:"

msgid "Barcode image copied."
msgstr "바코드 이미지가 복사되었습니다."

msgid "Base64"
msgstr "Base64"

msgid "Base64 encoding and decoding; input and output can independently select UTF-8 text or files;"
msgstr "Base64 인코딩 및 디코딩; 입력 및 출력은 UTF-8 텍스트 또는 파일을 독립적으로 선택할 수 있습니다."

msgid "Base64 error"
msgstr "Base64 오류"

msgid "Baud rate:"
msgstr "전송 속도:"

msgid "Bidirectional conversion between 64-bit Unix timestamp and UTC date and time; timestamp unit supports seconds and milliseconds;"
msgstr "64비트 Unix 타임스탬프와 UTC 날짜 및 시간 간의 양방향 변환. 타임스탬프 단위는 초와 밀리초를 지원합니다."

msgid "Binary"
msgstr "바이너리"

msgid "Binary files (*.bin)|*.bin|All files (*.*)|*.*"
msgstr "바이너리 파일(*.bin)|*.bin|모든 파일(*.*)|*.*"

msgid "Bit field members are not supported."
msgstr "비트 필드 멤버는 지원되지 않습니다."

msgid "Bits set: %d / 64"
msgstr "비트 세트: %d / 64"

msgid "Bitset64"
msgstr "비트셋64"

msgid "Blank"
msgstr "공백"

msgid "Both folders have been synchronized."
msgstr "두 폴더가 모두 동기화되었습니다."

msgid "C structure definition"
msgstr "C 구조 정의"

msgid "CBC/ECB optional PKCS, Zero, ISO/IEC 7816-4 or no padding; supports secure random key, IV/Nonce and RSA key pair generation."
msgstr "CBC/ECB 선택적 PKCS, Zero, ISO/IEC 7816-4 또는 패딩 없음; 보안 무작위 키, IV/Nonce 및 RSA 키 쌍 생성을 지원합니다."

msgid "CRC calculation error"
msgstr "CRC 계산 오류"

msgid "CRC calculator"
msgstr "CRC 계산기"

msgid "Calculate"
msgstr "계산하다"

msgid "Calculate hashes for text, hexadecimal data, or files"
msgstr "텍스트, 16진수 데이터 또는 파일의 해시 계산"

msgid "Calculate standard and custom CRC values for text, bytes, or files"
msgstr "텍스트, 바이트 또는 파일에 대한 표준 및 사용자 정의 CRC 값을 계산합니다."

msgid "Calculating file CRC in the background ..."
msgstr "백그라운드에서 파일 CRC를 계산하는 중..."

msgid "Calculation completed."
msgstr "계산이 완료되었습니다."

msgid "Cancel"
msgstr "취소"

msgid "Canceled."
msgstr "취소되었습니다."

msgid "Character %lu, “%s”, is outside the Latin-1 range (00–FF)."
msgstr "문자 %lu, “%s”는 Latin-1 범위(00-FF)를 벗어났습니다."

msgid "Clear"
msgstr "지우기"

msgid "Clear all"
msgstr "모두 지우기"

msgid "Clear log"
msgstr "로그 지우기"

msgid "Clear results"
msgstr "명확한 결과"

msgid "Cleared."
msgstr "삭제되었습니다."

msgid "Close"
msgstr "닫기"

msgid "Code"
msgstr "코드"

msgid "Code 128-B content"
msgstr "코드 128-B 내용"

msgid "Code 128-B content cannot exceed 200 characters."
msgstr "코드 128-B 내용은 200자를 초과할 수 없습니다."

msgid "Code 128-B generates the checksum automatically."
msgstr "코드 128-B는 체크섬을 자동으로 생성합니다."

msgid "Code 128-B only supports ASCII 32~126 characters."
msgstr "코드 128-B는 ASCII 32~126자만 지원합니다."

msgid "Code and comments can be counted on the same line (for example, trailing comments)."
msgstr "코드와 주석은 같은 줄에 계산될 수 있습니다(예: 후행 주석)."

msgid "Comments"
msgstr "댓글"

msgid "Common baud rates can be selected or manually entered from 1 to 4000000."
msgstr "공통 전송 속도는 1~4000000 사이에서 선택하거나 수동으로 입력할 수 있습니다."

msgid "Commonly used files such as HTML/XML, CSS, Vue, CMake and their comment styles; the maximum size of a single file is 512 MiB."
msgstr "HTML/XML, CSS, Vue, CMake 및 해당 주석 스타일과 같이 일반적으로 사용되는 파일. 단일 파일의 최대 크기는 512MiB입니다."

msgid "Communication client"
msgstr "통신 클라이언트"

msgid "Communication client: Windows, Linux, and macOS all support serial ports, and support TCP, UDP, WebSocket, and MQTT 3.1.1; request/response data can be optionally Hex or ASCII;"
msgstr "통신 클라이언트: Windows, Linux 및 macOS는 모두 직렬 포트를 지원하고 TCP, UDP, WebSocket 및 MQTT 3.1.1을 지원합니다. 요청/응답 데이터는 선택적으로 Hex 또는 ASCII일 수 있습니다."

msgid "Communication server"
msgstr "통신서버"

msgid "Communication server: Windows, Linux, and macOS can all monitor the serial port and support TCP, UDP, WebSocket, and MQTT 3.1.1; receiving frames can be Hex or ASCII;"
msgstr "통신 서버: Windows, Linux 및 macOS는 모두 직렬 포트를 모니터링하고 TCP, UDP, WebSocket 및 MQTT 3.1.1을 지원할 수 있습니다. 수신 프레임은 Hex 또는 ASCII일 수 있습니다."

msgid "Compare two directories and synchronize newer or one-sided files"
msgstr "두 디렉터리를 비교하고 최신 파일이나 일방적인 파일을 동기화합니다."

msgid "Compare two folders and their subdirectories; generate synchronized previews based on modification time; copy newer files and single-sided files in both directions;"
msgstr "두 폴더와 해당 하위 디렉터리를 비교합니다. 수정 시간을 기준으로 동기화된 미리보기를 생성합니다. 최신 파일과 단면 파일을 양방향으로 복사합니다."

msgid "Completed %lu files, copy failed:\n%s"
msgstr "%lu 파일이 완료되었으나 복사에 실패했습니다.\n%s"

msgid "Completed: %llu bytes, %lu algorithms."
msgstr "완료됨: %llu 바이트, %lu 알고리즘."

