msgstr "동적 꼬리 배열에는 두 개 이상의 구조체 멤버가 필요합니다."

msgid "ECB (legacy)"
msgstr "ECB(레거시)"

msgid "Each hexadecimal value and bit status are updated together, supporting copying the results."
msgstr "각 16진수 값과 비트 상태가 함께 업데이트되어 결과 복사를 지원합니다."

msgid "Edit receive/send pairs"
msgstr "수신/송신 쌍 편집"

msgid "Edit selected receive/send mapping"
msgstr "선택한 수신/전송 매핑 편집"

msgid "Edit selected send/receive pair"
msgstr "선택한 보내기/받기 쌍 편집"

msgid "Edit send/receive pairs"
msgstr "보내기/받기 쌍 편집"

msgid "Enable this mapping"
msgstr "이 매핑을 활성화합니다"

msgid "Encode ASCII text as a Code 128-B barcode"
msgstr "ASCII 텍스트를 코드 128-B 바코드로 인코딩"

msgid "Encode UTF-8 text as a QR Code image"
msgstr "UTF-8 텍스트를 QR 코드 이미지로 인코딩"

