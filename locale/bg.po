msgstr "ASCII текстът може да съдържа само знаци от 0x00 до 0x7F."

msgid "ASCII text cannot be empty."
msgstr "ASCII текстът не може да бъде празен."

msgid "About (&A)"
msgstr "Относно (&A)"

msgid "About iTool"
msgstr "Относно iTool"

msgid "About to modify %lu files. This cannot be undone automatically. Continue?"
msgstr "Предстои да модифицирам %lu файлове. Това не може да се отмени автоматично. Продължаване?"

msgid "About to rename %lu files. Continue?"
msgstr "Предстои да преименува %lu файлове. Продължаване?"

msgid "Add leading zeros to numbered filenames for natural sorting"
msgstr "Добавете водещи нули към номерирани имена на файлове за естествено сортиране"

msgid "Add new receive/send pair"
msgstr "Добавете нова двойка за получаване/изпращане"

