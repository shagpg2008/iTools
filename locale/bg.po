msgstr "Добавете нова двойка изпращане/получаване"

msgid "Added receive/send mapping"
msgstr "Добавено картографиране за получаване/изпращане"

msgid "Adds 80 first, then pads with 00."
msgstr "Първо добавя 80, след това допълва с 00."

msgid "Algorithm and parameters"
msgstr "Алгоритъм и параметри"

msgid "Algorithm:"
msgstr "Алгоритъм:"

msgid "Algorithms (22 types): MD5; SHA1; SHA2-224/256/384/512; SHA3-224/256/384/512; Keccak-224/256/384/512; RIPEMD-128/160/256/320; BLAKE2s-256; BLAKE2b-256/512; SM3. Multiple algorithms can be calculated at once."
msgstr "Алгоритми (22 вида): MD5; SHA1; SHA2-224/256/384/512; SHA3-224/256/384/512; Кечак-224/256/384/512; РИПЕМД-128/160/256/320; BLAKE2s-256; BLAKE2b-256/512; SM3. Множество алгоритми могат да бъдат изчислени наведнъж."

msgid "Aliases cannot be provided after the closing curly brace of a non-typedef structure."
msgstr "Псевдонимите не могат да се предоставят след затварящата фигурна скоба на структура, която не е typedef."

msgid "Alignment:"
msgstr "Подравняване:"

msgid "All files (*.*)|*.*"
msgstr "Всички файлове (*.*)|*.*"

msgid "Anonymous structures must provide a typedef name."
msgstr "Анонимните структури трябва да предоставят име с дефиниран тип."

msgid "Any non-empty"
msgstr "Всяко непразно"

msgid "Array length missing."
msgstr "Липсва дължина на масива."

msgid "Array length must be a positive integer or a defined numeric macro."
msgstr "Дължината на масива трябва да бъде положително цяло число или дефиниран цифров макрос."

msgid "Array length must be greater than zero."
msgstr "Дължината на масива трябва да е по-голяма от нула."

msgid "Automatically calculate checksum, adjust zoom and copy image or save as PNG."
msgstr "Автоматично изчисляване на контролна сума, регулиране на мащаба и копиране на изображение или запазване като PNG."

msgid "BIN file"
msgstr "BIN файл"

msgid "Barcode encoder"
msgstr "Баркод енкодер"

msgid "Barcode encoding"
msgstr "Кодиране на баркод"

msgid "Barcode height:"
msgstr "Височина на баркода:"

msgid "Barcode image copied."
msgstr "Изображението на баркод е копирано."

msgid "Base64"
msgstr "Base64"

msgid "Base64 encoding and decoding; input and output can independently select UTF-8 text or files;"
msgstr "Base64 кодиране и декодиране; входът и изходът могат независимо да избират UTF-8 текст или файлове;"

msgid "Base64 error"
msgstr "Грешка в Base64"

msgid "Baud rate:"
msgstr "Скорост на предаване:"

msgid "Bidirectional conversion between 64-bit Unix timestamp and UTC date and time; timestamp unit supports seconds and milliseconds;"
msgstr "Двупосочно преобразуване между 64-битово времево клеймо на Unix и UTC дата и час; модулът за клеймо поддържа секунди и милисекунди;"

msgid "Binary"
msgstr "Двоичен"

msgid "Binary files (*.bin)|*.bin|All files (*.*)|*.*"
msgstr "Двоични файлове (*.bin)|*.bin|Всички файлове (*.*)|*.*"

msgid "Bit field members are not supported."
msgstr "Членовете на битово поле не се поддържат."

msgid "Bits set: %d / 64"
msgstr "Комплект битове: %d / 64"

msgid "Bitset64"
msgstr "Bitset64"

msgid "Blank"
msgstr "Празно"

msgid "Both folders have been synchronized."
msgstr "И двете папки са синхронизирани."

msgid "C structure definition"
msgstr "Дефиниция на C структура"

msgid "CBC/ECB optional PKCS, Zero, ISO/IEC 7816-4 or no padding; supports secure random key, IV/Nonce and RSA key pair generation."
msgstr "CBC/ECB по избор PKCS, Zero, ISO/IEC 7816-4 или без подложка; поддържа защитен случаен ключ, генериране на двойки ключове IV/Nonce и RSA."

msgid "CRC calculation error"
msgstr "Грешка в изчислението на CRC"

msgid "CRC calculator"
msgstr "CRC калкулатор"

msgid "Calculate"
msgstr "Изчислете"

msgid "Calculate hashes for text, hexadecimal data, or files"
msgstr "Изчислете хешове за текст, шестнадесетични данни или файлове"

msgid "Calculate standard and custom CRC values for text, bytes, or files"
msgstr "Изчислете стандартни и потребителски CRC стойности за текст, байтове или файлове"

msgid "Calculating file CRC in the background ..."
msgstr "Изчисляване на CRC на файла във фонов режим..."

msgid "Calculation completed."
msgstr "Изчислението е завършено."

msgid "Cancel"
msgstr "Отказ"

msgid "Canceled."
msgstr "Отменено."

msgid "Character %lu, “%s”, is outside the Latin-1 range (00–FF)."
msgstr "Символът %lu, „%s“, е извън обхвата на Latin-1 (00–FF)."

