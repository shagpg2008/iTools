msgstr "Персонализираният параметър надвишава битовата ширина, зададена от Width."

msgid "A duplicate target filename exists; operation stopped."
msgstr "Съществува дублирано целево име на файл; операцията е спряна."

msgid "A sync preview will be automatically generated after selecting two folders."
msgstr "Визуализация за синхронизиране ще се генерира автоматично след избиране на две папки."

msgid "A zero-length array is only supported as the last structure member."
msgstr "Масив с нулева дължина се поддържа само като последен член на структурата."

msgid "AAD (UTF-8):"
msgstr "AAD (UTF-8):"

msgid "ASCII converter"
msgstr "ASCII конвертор"

msgid "ASCII string"
msgstr "ASCII низ"

