msgstr "ясно"

msgid "Clear all"
msgstr "Изчисти всички"

msgid "Clear log"
msgstr "Изчистване на дневника"

msgid "Clear results"
msgstr "Ясни резултати"

msgid "Cleared."
msgstr "Изчистено."

msgid "Close"
msgstr "затвори"

msgid "Code"
msgstr "Код"

msgid "Code 128-B content"
msgstr "Код 128-Б съдържание"

