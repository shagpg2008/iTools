msgstr "Темата MQTT PUBLISH е невалидна."

msgid "The MQTT SUBACK is invalid or the subscription was refused."
msgstr "MQTT SUBACK е невалиден или абонаментът е бил отказан."

msgid "The MQTT SUBSCRIBE message is invalid."
msgstr "Съобщението MQTT SUBSCRIBE е невалидно."

msgid "The MQTT publish topic is invalid."
msgstr "Темата за публикуване на MQTT е невалидна."

msgid "The MQTT subscription topic is invalid."
msgstr "Темата за абонамент за MQTT е невалидна."

msgid "The UTC date or time is outside the valid range."
msgstr "Датата или часът UTC е извън валидния диапазон."

msgid "The UTC time contains an invalid number."
msgstr "UTC времето съдържа невалидно число."

msgid "The UTC time format should be YYYY-MM-DD HH:MM:SS[.mmm]."
msgstr "Форматът на UTC часа трябва да бъде ГГГГ-ММ-ДД ЧЧ:ММ:СС[.ммм]."

msgid "The WebSocket peer has closed the connection."
msgstr "Партньорът WebSocket затвори връзката."

msgid "The barcode content cannot be empty."
msgstr "Съдържанието на баркода не може да бъде празно."

