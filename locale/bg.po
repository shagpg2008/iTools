msgid "%lu header file entries have been loaded; include will be expanded recursively during parsing."
msgstr "%lu записи на заглавен файл са заредени; включването ще бъде разширено рекурсивно по време на анализиране."

msgid "%s completed: %u -> %u bytes"
msgstr "%s завършен: %u -> %u байта"

msgid "/ No verification"
msgstr "/ Без проверка"

msgid "/check"
msgstr "/проверете"

msgid "1 byte (compact)"
msgstr "1 байт (компактен)"

msgid "1.5 stop bits can only be used in combination with 5 data bits."
msgstr "1,5 стоп бита могат да се използват само в комбинация с 5 бита данни."

