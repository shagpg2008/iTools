msgid "The penultimate member must be an 8-32 bit integer scalar for a dynamic tail array."
msgstr "Предпоследният член трябва да бъде 8-32 битов цял скаларен масив за динамичен опашен масив."

msgid "The receive cache has exceeded the limit and has been cleared."
msgstr "Кешът за получаване е надвишил ограничението и е изчистен."

msgid "The received data cannot be empty."
msgstr "Получените данни не могат да бъдат празни."

msgid "The received frames cannot be the same or prefix each other, otherwise the TCP/serial port cannot determine the frame boundary."
msgstr "Получените кадри не могат да бъдат еднакви или да се префиксират един към друг, в противен случай TCP/серийният порт не може да определи границата на рамката."

msgid "The regular expression is invalid."
msgstr "Регулярният израз е невалиден."

msgid "The replacement produced an invalid filename."
msgstr "Замяната създаде невалидно име на файл."

msgid "The request received was not a valid MQTT 3.1.1 CONNECT."
msgstr "Получената заявка не е валидна MQTT 3.1.1 CONNECT."

msgid "The request received was not a valid WebSocket RFC 6455 handshake."
msgstr "Получената заявка не беше валидно ръкостискане на WebSocket RFC 6455."

msgid "The root structure is invalid."
msgstr "Основната структура е невалидна."

