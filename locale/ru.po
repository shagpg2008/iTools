msgid "%lu header file entries have been loaded; include will be expanded recursively during parsing."
msgstr "Записи файла заголовка %lu загружены; include будет рекурсивно расширяться во время синтаксического анализа."

msgid "%s completed: %u -> %u bytes"
msgstr "%s завершено: %u -> %u байт"

msgid "/ No verification"
msgstr "/ Без проверки"

msgid "/check"
msgstr "/проверить"

msgid "1 byte (compact)"
msgstr "1 байт (компактный)"

msgid "1.5 stop bits can only be used in combination with 5 data bits."
msgstr "1,5 стоповых бита можно использовать только в сочетании с 5 битами данных."

msgid "2 bytes"
msgstr "2 байта"

msgid "3DES (legacy)"
msgstr "3DES (устаревший)"

msgid "4 bytes"
msgstr "4 байта"

msgid "5 data bits cannot be combined with 2 stop bits."
msgstr "5 бит данных не могут быть объединены с 2 стоповыми битами."

msgid "64-bit unsigned integer"
msgstr "64-битное целое число без знака"

msgid "8 bytes"
msgstr "8 байт"

msgid "A custom parameter exceeds the bit width specified by Width."
msgstr "Пользовательский параметр превышает разрядность, указанную в параметре Width."

msgid "A duplicate target filename exists; operation stopped."
msgstr "Существует повторяющееся имя целевого файла; операция остановлена."

msgid "A sync preview will be automatically generated after selecting two folders."
msgstr "Предварительный просмотр синхронизации будет автоматически создан после выбора двух папок."

msgid "A zero-length array is only supported as the last structure member."
msgstr "Массив нулевой длины поддерживается только в качестве последнего члена структуры."

msgid "AAD (UTF-8):"
msgstr "ААД (UTF-8):"

msgid "ASCII converter"
msgstr "ASCII-конвертер"

msgid "ASCII string"
msgstr "ASCII-строка"

msgid "ASCII text can only contain characters from 0x00 to 0x7F."
msgstr "Текст ASCII может содержать только символы от 0x00 до 0x7F."

msgid "ASCII text cannot be empty."
msgstr "Текст ASCII не может быть пустым."

msgid "About (&A)"
msgstr "О (&А)"

msgid "About iTool"
msgstr "О iTool"

msgid "About to modify %lu files. This cannot be undone automatically. Continue?"
msgstr "Собираюсь изменить файлы %lu. Это не может быть отменено автоматически. Продолжать?"

msgid "About to rename %lu files. Continue?"
msgstr "Собираюсь переименовать файлы %lu. Продолжать?"

msgid "Add leading zeros to numbered filenames for natural sorting"
msgstr "Добавляйте ведущие нули к пронумерованным именам файлов для естественной сортировки."

msgid "Add new receive/send pair"
msgstr "Добавить новую пару приема/отправки"

msgid "Add new send/receive pair"
msgstr "Добавить новую пару отправки/получения"

msgid "Added receive/send mapping"
msgstr "Добавлено сопоставление приема/отправки."

msgid "Adds 80 first, then pads with 00."
msgstr "Сначала добавляет 80, затем дополняет 00."

msgid "Algorithm and parameters"
msgstr "Алгоритм и параметры"

msgid "Algorithm:"
msgstr "Алгоритм:"

msgid "Algorithms (22 types): MD5; SHA1; SHA2-224/256/384/512; SHA3-224/256/384/512; Keccak-224/256/384/512; RIPEMD-128/160/256/320; BLAKE2s-256; BLAKE2b-256/512; SM3. Multiple algorithms can be calculated at once."
msgstr "Алгоритмы (22 типа): MD5; ША1; ША2-224/256/384/512; ША3-224/256/384/512; Кечак-224/256/384/512; РИПЕМД-128/160/256/320; БЛЕЙК2с-256; BLAKE2b-256/512; СМ3. Несколько алгоритмов могут быть рассчитаны одновременно."

msgid "Aliases cannot be provided after the closing curly brace of a non-typedef structure."
msgstr "Псевдонимы не могут быть предоставлены после закрывающей фигурной скобки структуры без определения типа."

msgid "Alignment:"
msgstr "Выравнивание:"

msgid "All files (*.*)|*.*"
msgstr "Все файлы (*.*)|*.*"

msgid "Anonymous structures must provide a typedef name."
msgstr "Анонимные структуры должны предоставлять имя typedef."

msgid "Any non-empty"
msgstr "Любой непустой"

msgid "Array length missing."
msgstr "Не указана длина массива."

msgid "Array length must be a positive integer or a defined numeric macro."
msgstr "Длина массива должна быть положительным целым числом или определенным числовым макросом."

msgid "Array length must be greater than zero."
msgstr "Длина массива должна быть больше нуля."

msgid "Automatically calculate checksum, adjust zoom and copy image or save as PNG."
msgstr "Автоматически вычисляйте контрольную сумму, регулируйте масштаб и копируйте изображение или сохраняйте его в формате PNG."

msgid "BIN file"
msgstr "BIN-файл"

msgid "Barcode encoder"
msgstr "Кодер штрих-кода"

msgid "Barcode encoding"
msgstr "Кодирование штрих-кода"

msgid "Barcode height:"
msgstr "Высота штрих-кода:"

msgid "Barcode image copied."
msgstr "Изображение штрих-кода скопировано."

msgid "Base64"
msgstr "База64"

msgid "Base64 encoding and decoding; input and output can independently select UTF-8 text or files;"
msgstr "Кодирование и декодирование Base64; ввод и вывод могут независимо выбирать текст или файлы UTF-8;"

msgid "Base64 error"
msgstr "Ошибка Base64"

msgid "Baud rate:"
msgstr "Скорость передачи данных:"

msgid "Bidirectional conversion between 64-bit Unix timestamp and UTC date and time; timestamp unit supports seconds and milliseconds;"
msgstr "Двунаправленное преобразование между 64-битной меткой времени Unix и датой и временем UTC; единица измерения времени поддерживает секунды и миллисекунды;"

msgid "Binary"
msgstr "Двоичный"

msgid "Binary files (*.bin)|*.bin|All files (*.*)|*.*"
msgstr "Бинарные файлы (*.bin)|*.bin|Все файлы (*.*)|*.*"

msgid "Bit field members are not supported."
msgstr "Члены битового поля не поддерживаются."

msgid "Bits set: %d / 64"
msgstr "Набор битов: %d/64"

msgid "Bitset64"
msgstr "Битсет64"

msgid "Blank"
msgstr "Пустой"

msgid "Both folders have been synchronized."
msgstr "Обе папки синхронизировались."

msgid "C structure definition"
msgstr "Определение структуры C"

msgid "CBC/ECB optional PKCS, Zero, ISO/IEC 7816-4 or no padding; supports secure random key, IV/Nonce and RSA key pair generation."
msgstr "CBC/ECB опционально PKCS, ноль, ISO/IEC 7816-4 или без заполнения; поддерживает безопасный случайный ключ, генерацию пары ключей IV/Nonce и RSA."

msgid "CRC calculation error"
msgstr "Ошибка расчета CRC"

msgid "CRC calculator"
msgstr "Калькулятор CRC"

msgid "Calculate"
msgstr "Рассчитать"

msgid "Calculate hashes for text, hexadecimal data, or files"
msgstr "Вычисление хешей для текста, шестнадцатеричных данных или файлов"

msgid "Calculate standard and custom CRC values for text, bytes, or files"
msgstr "Вычисление стандартных и пользовательских значений CRC для текста, байтов или файлов."

msgid "Calculating file CRC in the background ..."
msgstr "Вычисление CRC файла в фоновом режиме..."

msgid "Calculation completed."
msgstr "Расчет завершен."

msgid "Cancel"
msgstr "Отмена"

msgid "Canceled."
msgstr "Отменено."

msgid "Character %lu, “%s”, is outside the Latin-1 range (00–FF)."
msgstr "Символ %lu, «%s», находится за пределами диапазона Latin-1 (00–FF)."

