msgstr "Pregledajte i uredite svaki bit 64-bitnog nepredznačenog cijelog broja"

msgid "Warning: Crypto++ names its XXTEA implementation BTEA and marks it as not thoroughly tested; input must be at least 8 bytes and a multiple of 4."
msgstr "Upozorenje: Crypto++ naziva svoju XXTEA implementaciju BTEA i označava je kao ne temeljito testiranu; unos mora biti najmanje 8 bajtova i višekratnik broja 4."

msgid "Warning: ECB exposes data patterns and is not recommended for real data."
msgstr "Upozorenje: ECB otkriva uzorke podataka i ne preporučuje se za stvarne podatke."

msgid "Warning: Prefer OAEP; PKCS#1 v1.5 is provided only for compatibility."
msgstr "Upozorenje: preferirajte OAEP; PKCS#1 v1.5 dostupan je samo radi kompatibilnosti."

msgid "Warning: This algorithm is insecure and is provided only for legacy compatibility."
msgstr "Upozorenje: ovaj algoritam nije siguran i pruža se samo za kompatibilnost s naslijeđem."

msgid "Warning: This algorithm is intended for legacy systems or protocols; prefer AES-GCM for new data."
msgstr "Upozorenje: Ovaj algoritam je namijenjen naslijeđenim sustavima ili protokolima; radije AES-GCM za nove podatke."

