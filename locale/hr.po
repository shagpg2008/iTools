msgstr "UTC vrijeme sadrži nevažeći broj."

msgid "The UTC time format should be YYYY-MM-DD HH:MM:SS[.mmm]."
msgstr "Format UTC vremena treba biti GGGG-MM-DD HH:MM:SS[.mmm]."

msgid "The WebSocket peer has closed the connection."
msgstr "WebSocket peer zatvorio je vezu."

msgid "The barcode content cannot be empty."
msgstr "Sadržaj crtičnog koda ne može biti prazan."

msgid "The baud rate must be an integer between 1 and 4000000."
msgstr "Brzina prijenosa mora biti cijeli broj između 1 i 4000000."

msgid "The decoded result is not UTF-8 text. Output to a file to preserve the binary data."
msgstr "Dekodirani rezultat nije UTF-8 tekst. Izlaz u datoteku za očuvanje binarnih podataka."

msgid "The dropped file or directory is invalid."
msgstr "Ispuštena datoteka ili direktorij nisu valjani."

msgid "The file exceeds 16 MiB. Write to a file to avoid excessive text-box memory use."
msgstr "Datoteka premašuje 16 MiB. Pišite u datoteku kako biste izbjegli prekomjerno korištenje memorije tekstualnog okvira."

msgid "The header file directory is invalid."
msgstr "Direktorij datoteke zaglavlja je nevažeći."

msgid "The input and output files cannot be the same."
msgstr "Ulazna i izlazna datoteka ne mogu biti iste."

msgid "The language setting could not be saved."
msgstr "Postavka jezika nije mogla biti spremljena."

msgid "The last member must be an array for a dynamic tail array."
msgstr "Posljednji član mora biti polje za dinamičko repno polje."

msgid "The match expression cannot be empty."
msgstr "Izraz podudaranja ne može biti prazan."

msgid "The parsing results have been cleared."
msgstr "Rezultati analize su izbrisani."

msgid "The penultimate member must be an 8-32 bit integer scalar for a dynamic tail array."
msgstr "Pretposljednji član mora biti 8-32 bitni cjelobrojni skalar za dinamičko repno polje."

msgid "The receive cache has exceeded the limit and has been cleared."
msgstr "Predmemorija primanja premašila je ograničenje i obrisana je."

msgid "The received data cannot be empty."
msgstr "Primljeni podaci ne mogu biti prazni."

msgid "The received frames cannot be the same or prefix each other, otherwise the TCP/serial port cannot determine the frame boundary."
msgstr "Primljeni okviri ne mogu biti isti niti imati jedan prefiks, inače TCP/serijski port ne može odrediti granicu okvira."

msgid "The regular expression is invalid."
msgstr "Regularni izraz je nevažeći."

msgid "The replacement produced an invalid filename."
msgstr "Zamjena je proizvela nevažeći naziv datoteke."

msgid "The request received was not a valid MQTT 3.1.1 CONNECT."
msgstr "Primljeni zahtjev nije valjan MQTT 3.1.1 CONNECT."

msgid "The request received was not a valid WebSocket RFC 6455 handshake."
msgstr "Primljeni zahtjev nije valjano rukovanje WebSocket RFC 6455."

msgid "The root structure is invalid."
msgstr "Struktura korijena je nevažeća."

msgid "The serial port or host cannot be empty."
msgstr "Serijski port ili host ne mogu biti prazni."

msgid "The server has ended."
msgstr "Poslužitelj je završio."

msgid "The server has stopped."
msgstr "Poslužitelj je stao."

msgid "The server rejected the WebSocket upgrade or the handshake response was invalid."
msgstr "Poslužitelj je odbio nadogradnju WebSocketa ili je odgovor na rukovanje bio nevažeći."

msgid "The two folders cannot be the same, nor can they be subdirectories of each other."
msgstr "Dvije mape ne mogu biti iste, niti mogu biti jedna drugoj poddirektorije."

msgid "The value format is invalid or outside the range of a 64-bit unsigned integer."
msgstr "Format vrijednosti je nevažeći ili je izvan raspona 64-bitnog cijelog broja bez predznaka."

