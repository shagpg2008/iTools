msgstr "Opozorilo: ECB razkriva vzorce podatkov in ni priporočljivo za resnične podatke."

msgid "Warning: Prefer OAEP; PKCS#1 v1.5 is provided only for compatibility."
msgstr "Opozorilo: raje OAEP; PKCS#1 v1.5 je na voljo samo zaradi združljivosti."

msgid "Warning: This algorithm is insecure and is provided only for legacy compatibility."
msgstr "Opozorilo: ta algoritem ni varen in je na voljo samo za starejše združljivost."

msgid "Warning: This algorithm is intended for legacy systems or protocols; prefer AES-GCM for new data."
msgstr "Opozorilo: Ta algoritem je namenjen podedovanim sistemom ali protokolom; raje AES-GCM za nove podatke."

