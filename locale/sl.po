msgid "The baud rate must be an integer between 1 and 4000000."
msgstr "Hitrost prenosa mora biti celo število med 1 in 4000000."

msgid "The decoded result is not UTF-8 text. Output to a file to preserve the binary data."
msgstr "Dekodirani rezultat ni besedilo UTF-8. Izhod v datoteko za ohranitev binarnih podatkov."

msgid "The dropped file or directory is invalid."
msgstr "Spuščena datoteka ali imenik ni veljaven."

msgid "The file exceeds 16 MiB. Write to a file to avoid excessive text-box memory use."
msgstr "Datoteka presega 16 MiB. Pišite v datoteko, da preprečite pretirano uporabo pomnilnika polja z besedilom."

msgid "The header file directory is invalid."
msgstr "Imenik datoteke glave ni veljaven."

msgid "The input and output files cannot be the same."
msgstr "Vhodna in izhodna datoteka ne moreta biti enaki."

msgid "The language setting could not be saved."
msgstr "Nastavitve jezika ni bilo mogoče shraniti."

msgid "The last member must be an array for a dynamic tail array."
msgstr "Zadnji član mora biti polje za dinamično repno polje."

msgid "The match expression cannot be empty."
msgstr "Izraz za ujemanje ne sme biti prazen."

msgid "The parsing results have been cleared."
msgstr "Rezultati razčlenjevanja so bili izbrisani."

msgid "The penultimate member must be an 8-32 bit integer scalar for a dynamic tail array."
msgstr "Za dinamično repno matriko mora biti predzadnji član 8–32-bitni celoštevilski skalar."

msgid "The receive cache has exceeded the limit and has been cleared."
msgstr "Prejemni predpomnilnik je presegel omejitev in je bil počiščen."

msgid "The received data cannot be empty."
msgstr "Prejeti podatki ne smejo biti prazni."

msgid "The received frames cannot be the same or prefix each other, otherwise the TCP/serial port cannot determine the frame boundary."
msgstr "Prejeti okvirji ne morejo biti enaki ali imeti predpone drug drugega, sicer TCP/serijska vrata ne morejo določiti meje okvirja."

msgid "The regular expression is invalid."
msgstr "Regularni izraz je neveljaven."

msgid "The replacement produced an invalid filename."
msgstr "Zamenjava je povzročila neveljavno ime datoteke."

msgid "The request received was not a valid MQTT 3.1.1 CONNECT."
msgstr "Prejeta zahteva ni veljavna MQTT 3.1.1 CONNECT."

msgid "The request received was not a valid WebSocket RFC 6455 handshake."
msgstr "Prejeta zahteva ni bila veljavno rokovanje WebSocket RFC 6455."

msgid "The root structure is invalid."
msgstr "Korenska struktura je neveljavna."

msgid "The serial port or host cannot be empty."
msgstr "Serijska vrata ali gostitelj ne smejo biti prazna."

msgid "The server has ended."
msgstr "Strežnik se je končal."

msgid "The server has stopped."
msgstr "Strežnik se je ustavil."

msgid "The server rejected the WebSocket upgrade or the handshake response was invalid."
msgstr "Strežnik je zavrnil nadgradnjo WebSocket ali pa je bil odgovor na rokovanje neveljaven."

msgid "The two folders cannot be the same, nor can they be subdirectories of each other."
msgstr "Dve mapi ne moreta biti enaki, niti ne moreta biti druga drugi podimenika."

msgid "The value format is invalid or outside the range of a 64-bit unsigned integer."
msgstr "Oblika zapisa vrednosti je neveljavna ali je zunaj obsega 64-bitnega celega števila brez predznaka."

