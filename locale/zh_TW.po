msgid "The MQTT subscription topic is invalid."
msgstr "MQTT 訂閱主題無效。"

msgid "The UTC date or time is outside the valid range."
msgstr "UTC 日期或時間超出有效範圍。"

msgid "The UTC time contains an invalid number."
msgstr "UTC 時間包含無效數字。"

msgid "The UTC time format should be YYYY-MM-DD HH:MM:SS[.mmm]."
msgstr "UTC 時間格式應為 YYYY-MM-DD HH:MM:SS[.mmm]。"

msgid "The WebSocket peer has closed the connection."
msgstr "WebSocket 對端已關閉連線。"

msgid "The barcode content cannot be empty."
msgstr "條碼內容不能為空。"

msgid "The baud rate must be an integer between 1 and 4000000."
msgstr "波特率必須是 1～4000000 之間的整數。"

msgid "The decoded result is not UTF-8 text. Output to a file to preserve the binary data."
msgstr "還原結果不是 UTF-8 文字，請改為輸出到檔案以保留二進位資料。"

msgid "The dropped file or directory is invalid."
msgstr "拖入的檔案或目錄無效。"

msgid "The file exceeds 16 MiB. Write to a file to avoid excessive text-box memory use."
msgstr "檔案超過 16 MiB，請選擇寫入檔案以免文字方塊占用過多記憶體。"

msgid "The header file directory is invalid."
msgstr "頭檔目錄無效。"

msgid "The input and output files cannot be the same."
msgstr "輸入與輸出檔案不能相同。"

msgid "The language setting could not be saved."
msgstr "無法儲存語言設定。"

msgid "The last member must be an array for a dynamic tail array."
msgstr "啟用動態尾部陣列時，最後一個成員必須是陣列。"

msgid "The match expression cannot be empty."
msgstr "比對表示式不能為空。"

msgid "The parsing results have been cleared."
msgstr "已清空解析結果。"

msgid "The penultimate member must be an 8-32 bit integer scalar for a dynamic tail array."
msgstr "啟用動態尾部陣列時，倒數第二個成員必須是 8～32 位元整數純量。"

msgid "The receive cache has exceeded the limit and has been cleared."
msgstr "接收快取超限，已清空"

msgid "The received data cannot be empty."
msgstr "接收資料不能為空。"

msgid "The received frames cannot be the same or prefix each other, otherwise the TCP/serial port cannot determine the frame boundary."
msgstr "接收訊框不能相同，也不能互為前綴，否則 TCP/串列埠無法確定訊框邊界。"

msgid "The regular expression is invalid."
msgstr "正規表示式無效。"

msgid "The replacement produced an invalid filename."
msgstr "取代產生了無效檔名。"

msgid "The request received was not a valid MQTT 3.1.1 CONNECT."
